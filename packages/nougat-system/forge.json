{
    "id": "nougat-system",
    "type": "shared",
    "target": {
        "windows": "System/nougat",
        "default": "System/libnougat"
    },
    "cflags": {
        "USE_CLANG": [
            "-O3",
            "-fPIC",
            "-std=c++20",
            "-Wno-c23-extensions"
        ],
        "windows": [
            "-O3",
            "-std=c++20",
            "-Wno-c23-extensions"
        ],
        "default": [
            "-O3",
            "-fPIC",
            "-std=c++20"
        ]
    },
    "includes": [
        "include"
    ],
    "sources": [
        "src"
    ],
    "requires": [
        "stdext"
    ],
    "libraries": {
        "windows": [ "Advapi32.lib" ],
        "default": [ "stdc++" ]
    }
}
